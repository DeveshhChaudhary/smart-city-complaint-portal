# ==============================================================================
# Smart City Complaint Portal - Backend Environment Template
# Copy this file to backend/.env and populate with your credentials.
# NEVER commit the actual backend/.env file with real secrets to version control.
# ==============================================================================

# Application Configuration
APP_NAME="Smart City Complaint Portal"
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Database & Auth Configuration
# Replace with your Supabase Project URL and API Key from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# JWT Authentication
# Secret key used for signing session tokens (must be random and securely generated)
JWT_SECRET=your-random-secret-key-change-this-in-production
JWT_EXPIRE_MINUTES=1440
