# ==============================================================================
# Smart City Complaint Portal - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
**/backend/.env
**/frontend/.env

# Preserve public environment template files
!.env.example
!.env.*.example
!*.env.example
!**/.env.example
!**/.env.*.example
!**/backend/.env.example
!**/frontend/.env.example

# ------------------------------------------------------------------------------
# Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Node & Frontend Build
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# ------------------------------------------------------------------------------
# Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Operating System & IDE Metadata
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
